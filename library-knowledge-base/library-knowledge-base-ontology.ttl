	rdfs:domain lkb:Work ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:synonym rdf:type owl:DatatypeProperty ;
	rdfs:label "Synonym"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:teaserSummary rdf:type owl:DatatypeProperty ;
	rdfs:label "Teaser summary"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:title rdf:type owl:DatatypeProperty ;
	rdfs:label "Title"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:triageOrder rdf:type owl:DatatypeProperty ;
	rdfs:label "Triage order"@en ;
	rdfs:comment "The order determined by heads of section to manage request allocation."@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range xsd:integer ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:workingPatternNote rdf:type owl:DatatypeProperty ;
	rdfs:label "Working pattern note"@en ;
	rdfs:comment "A note used to describe the working pattern of a subject specialist in terms of daily and hourly working patterns."@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .