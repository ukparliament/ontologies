	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:publicationDate rdf:type owl:DatatypeProperty ;
	rdfs:label "Publication date"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range xsd:dateTime ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:publishedURL rdf:type owl:DatatypeProperty ;
	rdfs:label "Published URL"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:reference rdf:type owl:DatatypeProperty ;
	rdfs:label "Reference"@en ;
	rdfs:comment "The bibliographic reference of a work, for example: 'SN00195' as the bibliographic reference for '1999 benefit uprating'."@en ;
	rdfs:domain lkb:Work ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:scopeNote rdf:type owl:DatatypeProperty ;
	rdfs:label "Scope note"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:shortLabel rdf:type owl:DatatypeProperty ;
