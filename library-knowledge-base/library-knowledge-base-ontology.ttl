# Prefixes

@prefix lkb: <http://parliament.uk/ontologies/library-knowledge-base/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:	<http://xmlns.com/foaf/0.1/> .

<http://parliament.uk/ontologies/library-knowledge-base/> 
    rdf:type owl:Ontology ;
    dcterms:title "Library Knowledge Base ontology"@en ;
    dcterms:created "2026-10-28"^^xsd:date ;
	dcterms:rights "Open Parliament Licence v3.0"@en ;
    dcterms:description "A model describing a knowledge base of the House of Commons Library."@en ;
	foaf:depiction <https://ukparliament.github.io/ontologies/library-knowledge-base/library-knowledge-base.svg> ;
	foaf:maker
		[ foaf:name "Robert Brook"; foaf:homepage <https://robert-brook.com/> ],
		[ foaf:name "Anna Buck" ],
		[ foaf:name "Suannah Foulis" ],
		[ foaf:name "Silver Oliver" ],
		[ foaf:name "Michael Smethurst"; foaf:homepage <http://smethur.st/> ],
	    [ foaf:name "Anya Somerville" ].

# Classes

lkb:Person rdf:type owl:Class ;
	rdfs:label "Person"@en ;
	rdfs:comment "A person."@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:Concept rdf:type owl:Class ;
	rdfs:label "Concept"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:ConceptType rdf:type owl:Class ;
	rdfs:label "Concept type"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:Organisation rdf:type owl:Class ;
	rdfs:label "Organisation"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:Specialism rdf:type owl:Class ;
	rdfs:label "Specialism"@en ;
	rdfs:comment "A person's currently assigned area of expertise used to determine which inquiries should be sent to them."@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:SpecialismType rdf:type owl:Class ;
	rdfs:label "Specialism type"@en ;
	rdfs:comment "A person's currently assigned area of expertise used to determine which inquiries should be sent to them."@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:Work rdf:type owl:Class ;
	rdfs:label "Work"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:WorkType rdf:type owl:Class ;
	rdfs:label "Work type"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:ResearchService rdf:type owl:Class ;
	rdfs:subClassOf lkb:Organisation ;
	rdfs:label "Research service"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:Section rdf:type owl:Class ;
	rdfs:subClassOf lkb:Organisation ;
	rdfs:label "Section"@en ;
	rdfs:comment ""@en ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
	
# Object Properties

lkb:author rdf:type owl:ObjectProperty ;
	rdfs:label "Author"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range lkb:Person ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:broaderTerm rdf:type owl:ObjectProperty ;
	rdfs:label "Broader term"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range lkb:Concept ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:conceptType rdf:type owl:ObjectProperty ;
	rdfs:label "Concept type"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range lkb:ConceptType ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:contributor rdf:type owl:ObjectProperty ;
	rdfs:label "Contributor"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range lkb:Person ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:inSection rdf:type owl:ObjectProperty ;
	rdfs:label "In section"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Person ;
	rdfs:range lkb:Section ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:isHeadOfSection rdf:type owl:ObjectProperty ;
	rdfs:label "Is head of section"@en ;
	rdfs:comment "Relates a person to the section they are head of."@en ;
	rdfs:domain lkb:Person ;
	rdfs:range lkb:Section ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:isSpecialismOf rdf:type owl:ObjectProperty ;
	rdfs:label "Is specialism of"@en ;
	rdfs:comment "The person who is currently assigned the specialism for the purposes of routing inquiries."@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range lkb:Person ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .
	
lkb:ownedBySection rdf:type owl:ObjectProperty ;
	rdfs:label "Owned by section"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range lkb:Section ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:publishedBy rdf:type owl:ObjectProperty ;
	rdfs:label "Published by"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range lkb:Organisation ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:sectionIn rdf:type owl:ObjectProperty ;
	rdfs:label "Section in"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Section ;
	rdfs:range lkb:ResearchService ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:specialismIn rdf:type owl:ObjectProperty ;
	rdfs:label "Specialism in"@en ;
	rdfs:comment "The subject with which the assigned specialism is in."@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range lkb:Concept ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:subject rdf:type owl:ObjectProperty ;
	rdfs:label "Subject"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range lkb:Concept ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:typeOfSpecialism rdf:type owl:ObjectProperty ;
	rdfs:label "Type of specialism"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range lkb:SpecialismType ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:workType rdf:type owl:ObjectProperty ;
	rdfs:label "Work type"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Work ;
	rdfs:range lkb:WorkType ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .


# Datatype Properties

lkb:acronym rdf:type owl:DatatypeProperty ;
	rdfs:label "Acronym type"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Section ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:alphabetisationLetter rdf:type owl:DatatypeProperty ;
	rdfs:label "Alphabetisation letter"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:alphabetisationLetter rdf:type owl:DatatypeProperty ;
	rdfs:label "Alphabetisation letter"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Person ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:alternativeName rdf:type owl:DatatypeProperty ;
	rdfs:label "Alternative name"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Person ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:availabilityNote rdf:type owl:DatatypeProperty ;
	rdfs:label "Availability note"@en ;
	rdfs:comment "A note used to record if a specialist is temporarily unavailable or as part of the soft delete process when a specialist has left the Library. This note does not appear in the Library Knowledge Base."@en ;
	rdfs:domain lkb:Person ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:brandColour rdf:type owl:DatatypeProperty ;
	rdfs:label "Brand colour"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:ResearchService ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:classType rdf:type owl:DatatypeProperty ;
	rdfs:label "Class type"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:description rdf:type owl:DatatypeProperty ;
	rdfs:label "Description"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Organisation ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:email rdf:type owl:DatatypeProperty ;
	rdfs:label "Email"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Person ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:email rdf:type owl:DatatypeProperty ;
	rdfs:label "Email"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Section ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:indexerNote rdf:type owl:DatatypeProperty ;
	rdfs:label "Indexer note"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:isCurrentlyAvailable rdf:type owl:DatatypeProperty ;
	rdfs:label "Is currently available"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Person ;
	rdfs:range xsd:boolean ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:isTopicTerm rdf:type owl:DatatypeProperty ;
	rdfs:label "Is topic term"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:boolean ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Concept ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:ConceptType ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Organisation ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:SpecialismType ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:WorkType ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:name rdf:type owl:DatatypeProperty ;
	rdfs:label "Name"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Person ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:phoneNumber rdf:type owl:DatatypeProperty ;
	rdfs:label "Phone number"@en ;
