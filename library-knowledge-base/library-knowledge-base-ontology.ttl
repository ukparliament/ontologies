	rdfs:domain lkb:Subject ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:ConceptScheme ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:Organisation ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
