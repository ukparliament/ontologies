	rdfs:comment ""@en ;
	rdfs:domain lkb:Specialism ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:SpecialismType ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:label rdf:type owl:DatatypeProperty ;
	rdfs:label "Label"@en ;
	rdfs:comment ""@en ;
	rdfs:domain lkb:PublicationWorkType ;
	rdfs:range xsd:string ;
	rdfs:isDefinedBy <http://parliament.uk/ontologies/library-knowledge-base/> .

lkb:sortName rdf:type owl:DatatypeProperty ;
	rdfs:label "Sort name"@en ;
